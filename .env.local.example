# ============================================================================
# mentoriaOS — VARIÁVEIS DE AMBIENTE (ETAPA 4)
# ============================================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para .env.local
# 2. Preencha com suas credenciais do Supabase e Anthropic
# 3. NUNCA faça commit de .env.local (já está no .gitignore)
# ============================================================================

# SUPABASE
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ANTHROPIC (Claude API)
ANTHROPIC_API_KEY=sk-ant-v4-your-api-key-here

# NEXT.js
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WEBHOOK SECRET (para validar chamadas da Edge Function)
WEBHOOK_SECRET=your-random-secret-here
